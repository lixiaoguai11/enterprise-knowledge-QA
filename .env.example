# Provider switch: deepseek or anthropic
LLM_PROVIDER=deepseek

# DeepSeek uses the OpenAI-compatible Chat Completions protocol
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat

# Anthropic uses the native Messages API protocol. For an Anthropic-compatible
# gateway, set its base URL here and provide the key expected by that gateway.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional OpenAI-compatible embedding service. When configured, it replaces
# local FastEmbed for both indexing document chunks and embedding queries.
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-bge-large-en-v1.5
EMBEDDING_BASE_URL=http://localhost:9990/v1

# Candidate reranking: bge_similarity reuses embedding vectors; qwen_api calls
# an OpenAI/Cohere-style JSON rerank endpoint; none keeps BM25/vector RRF only.
RERANKER_PROVIDER=bge_similarity
RERANK_API_KEY=
RERANK_MODEL_NAME=Qwen/Qwen3-Reranker-8B
RERANK_BASE_URL=http://192.168.110.23:16386/rerank
